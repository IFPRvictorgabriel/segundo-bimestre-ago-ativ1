programa
{
	
	funcao inicio()
	{
		real nota1, nota2, nota3, nota4, media

        nota1 = 9.0
        nota2 = 8.1
        nota3 = 7.0
        nota4 = 10.0

        media = (nota1 + nota2 + nota3 + nota4) / 4

        escreva("A média das notas é: ", media)
	}
}
